# Copy this to .env.format-to-wp and fill in your values.
# .env.format-to-wp is gitignored — never commit real credentials.

# ClickUp API token — https://app.clickup.com/settings/apps
CLICKUP_API_KEY=pk_your_token_here

# WordPress Application Password — WP Admin → Users → Edit user → Application Passwords
WP_USERNAME=aleksandra.velickovic@linkgraph.io
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
